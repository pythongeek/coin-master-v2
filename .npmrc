# P2-03 — top-level safety net. The authoritative .npmrc lives in
# backend/.npmrc (that's what the CI uses). This file is a fallback
# for tools that walk up the directory tree from the repo root.
# Mirrors the backend setting so a stray root-level `npm ci` still
# enforces the same contract. See backend/.npmrc for the
# engine-strict comment.
audit-level=high
engine-strict=false
