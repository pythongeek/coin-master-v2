# P2-03 — npm config for lockfile-strict installs + high-severity audit gate.
# This file is read by `npm ci` and `npm install` and by the npm
# registry client at large. Keep it in lockstep with the CI step in
# .github/workflows/ci.yml (npm audit --audit-level=high).
#
# `audit-level=high` mirrors what `npm audit` will fail on by default
# (high+ severity vulnerabilities). Operators can override per-env by
# passing `--audit-level=moderate` to a one-off audit, but the CI gate
# is the canonical contract.
audit-level=high
# `save-exact=false` is the npm default; we list it here for
# documentation. We do NOT enable `save-exact` because pinning every
# transitive dependency to an exact version makes upgrades painful
# for no security gain (the lockfile already pins them).
save-exact=false
# `engine-strict=true` would cause `npm ci` to fail when a transitive
# dependency declares an `engines` field that doesn't match the
# running Node version. This is currently the case for
# `geoip-lite@2.0.3` (which declares `node>=24.0.0` but is purely a
# runtime ESM module that works fine on Node 20). Leaving this
# disabled keeps the install robust; the production runtime Node
# version is enforced by the Dockerfile (Node 22-bookworm-slim). If
# a future major Node bump needs a strict engine check, set this
# to `true` and pin or replace the offending dep.
engine-strict=false
